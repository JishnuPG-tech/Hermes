# Force LF line endings for all shell scripts & Python files
# This prevents Windows CRLF from breaking Linux container execution

*.sh        text eol=lf
*.py        text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf

# Binary files - no line ending conversion
*.png       binary
*.jpg       binary
*.ico       binary
*.gz        binary
*.tar       binary
